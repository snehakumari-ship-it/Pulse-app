{
  "name": "pulse",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "packages/platform/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "clean:metro": "node scripts/kill-metro-ports.js && node scripts/clear-metro-cache.js",
    "clean:all": "bash scripts/clean-all.sh",
    "clean:all:modules": "bash scripts/clean-all.sh --modules",
    "dev": "node scripts/dev-with-oms.js",
    "dev:web-only": "cross-env NODE_OPTIONS=--max-old-space-size=8192 METRO_MAX_WORKERS=4 CI=false npm run web",
    "dev:clean": "npm run clean:metro && npm run web:clean",
    "start": "node scripts/run-expo.js start --go",
    "start:clean": "npm run clean:metro && node scripts/run-expo.js start --go -c",
    "start:dev-client": "node scripts/run-expo.js start",
    "start:simulator": "cross-env REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 node scripts/run-expo.js start --go --localhost",
    "start:go": "node scripts/run-expo.js start --go",
    "preview": "node scripts/run-expo.js start --go --tunnel",
    "start:tunnel": "node scripts/run-expo.js start --tunnel",
    "expo:cli": "node scripts/run-expo.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "cross-env DOTENV_CONFIG_OVERRIDE=true node scripts/run-expo.js start --web",
    "web:clean": "npm run clean:metro && cross-env DOTENV_CONFIG_OVERRIDE=true node scripts/run-expo.js start --web -c",
    "bundle:analyze": "cross-env EXPO_ATLAS=true NODE_OPTIONS=--max-old-space-size=8192 npx expo export --platform web",
    "bundle:analyze:open": "npx expo-atlas",
    "build": "npm run build:web",
    "build:web": "expo export --platform web && node scripts/compress-dist.js",
    "build:ci": "node scripts/build-ci.js",
    "build:admin": "cd analytics && npm ci --prefer-offline && npm run build && cp -r dist ../dist/ops-9f3a2c",
    "build:oms": "cd oms && npm ci --prefer-offline --legacy-peer-deps && npm run build && cp -r dist ../dist/oms",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "check:driver-view": "tsx scripts/check-driver-view-contract.ts",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit -p tsconfig.json",
    "typecheck:oms": "tsc --noEmit -p oms/tsconfig.app.json",
    "test": "jest",
    "test:v2": "jest --selectProjects pulse-v2 --no-coverage",
    "check:v2-boundaries": "jest --selectProjects pulse-v2 --testPathPattern=domain-table-guard --no-coverage",
    "test:navigation-policy": "jest lib/navigationPolicy --no-coverage",
    "test:e2e": "detox test -c ios.sim.debug",
    "test:e2e:build": "detox build -c ios.sim.debug",
    "test:web": "playwright test",
    "test:web:ui": "playwright test --ui",
    "test:web:headed": "playwright test --headed",
    "signin": "node nihas-tests/signin-flow.mjs",
    "tw:headless": "node nihas-tests/test-terminal-website.mjs",
    "test:web:report": "playwright show-report",
    "seed": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/seed-test-data.ts",
    "build:audit": "node scripts/netlify-build-audit.js",
    "build:audit:report": "node scripts/netlify-build-audit.js --output=netlify-build-report",
    "build:graph": "node scripts/find-startup-graph-offenders.mjs",
    "build:graph:strict": "node scripts/find-startup-graph-offenders.mjs --strict",
    "build:barrels": "node scripts/find-barrel-importers.mjs",
    "assets:optimize": "node scripts/optimize-assets.js",
    "db:audit": "bash scripts/sql/audit/run-linked.sh",
    "acceptance:baseline": "bash scripts/acceptance/print-acceptance-baseline.sh",
    "acceptance:verify": "bash scripts/acceptance/verify-orchestrator-v1.sh",
    "db:use-local": "bash scripts/use-local-supabase.sh",
    "db:use-cloud": "bash scripts/use-cloud-supabase.sh",
    "audit": "npm run dev --prefix tools/db-audit",
    "audit:build": "npm run build --prefix tools/db-audit",
    "audit:preview": "npm run preview --prefix tools/db-audit",
    "audit:legacy": "node tools/serve.js",
    "db:preflight": "bash scripts/db-preflight.sh",
    "db:push": "supabase db push --linked",
    "db:push-both": "bash scripts/push-both-dbs.sh",
    "marketplace:gate2-candidates": "supabase db query --linked -o table -f scripts/marketplace/gate2_list_branch_b_candidates.sql",
    "marketplace:gate3-harness": "node scripts/marketplace/parallel-bid-harness.mjs",
    "marketplace:gate3-harness:10": "node scripts/marketplace/parallel-bid-harness.mjs 10",
    "marketplace:gate3-harness:25": "node scripts/marketplace/parallel-bid-harness.mjs 25",
    "marketplace:gate3-harness:50": "node scripts/marketplace/parallel-bid-harness.mjs 50",
    "functions:deploy": "supabase functions deploy",
    "functions:deploy:auth": "supabase functions deploy check-user-by-phone driver-phone-signin-unverified link-driver-phone",
    "functions:deploy-both": "bash scripts/push-both-dbs.sh",
    "admin:dev": "npm run dev --prefix analytics",
    "admin:build": "npm run build --prefix analytics",
    "oms:dev": "npm run dev --prefix oms",
    "oms:build": "npm run build --prefix oms"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@google/genai": "^1.43.0",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@pulse/platform-workspace": "*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.2.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/query-async-storage-persister": "^5.100.9",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.100.9",
    "babel-preset-expo": "~54.0.10",
    "date-fns": "^4.3.0",
    "dotenv": "^17.3.1",
    "expo": "~54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-contacts": "~15.0.11",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-screen-capture": "~8.0.9",
    "expo-secure-store": "~15.0.3",
    "expo-sharing": "~14.0.8",
    "expo-sms": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "html2canvas": "^1.4.1",
    "jest-expo": "~54.0.17",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet-routing-machine": "^3.2.12",
    "lottie-react": "^2.4.1",
    "lottie-react-native": "^7.3.8",
    "lucide-react-native": "^0.577.0",
    "maplibre-gl": "^5.23.0",
    "moti": "^0.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "sqids": "^0.3.0",
    "tslib": "^2.8.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/react-native": "^12.4.5",
    "@types/jest": "^29.5.12",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "cross-env": "^7.0.3",
    "detox": "^19.6.7",
    "eslint": "^9.39.3",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "expo-detox-config-plugin": "^12.0.0",
    "expo-dev-client": "6.0.21",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.1.0",
    "sharp": "^0.34.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "description": "Mobile app for Pulse — same Supabase backend as **pulse-unified-base**. Built with **React Native (Expo)** and TypeScript for a runnable, long-running, and scalable mobile experience.",
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praveen-ggx/Pulse-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/praveen-ggx/Pulse-app/issues"
  },
  "homepage": "https://github.com/praveen-ggx/Pulse-app#readme"
}
